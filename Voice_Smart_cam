blueprint:
  name: Voice - Smart Camera Analyzer (Optimized)
  author: thaidv_fixed
  description: >
    Phân tích camera bằng AI theo câu hỏi bằng giọng nói.

    - Hỏi một camera → chỉ phân tích đúng camera đó và trả lời ngay.
    - Hỏi nhiều camera → chỉ phân tích các camera được yêu cầu.
    - Hỏi "tất cả camera", "camera nào", "các camera"... → phân tích tất cả camera.
    - Không xác định được camera → báo lỗi, KHÔNG tự động phân tích tất cả camera.
    - Hỗ trợ phòng khách, nhà xe, cửa trước, phòng master,
      phòng bếp, sân vườn và phòng trà.

  domain: script

  homeassistant:
    min_version: 2025.8.0

  input:
    entity_aliases_settings:
      name: Settings for Entity Aliases
      icon: mdi:format-list-bulleted
      input:
        entity_aliases:
          name: Entity Aliases
          description: >
            Sensor template chứa danh sách alias cho camera.
            Có thể dùng để đặt tên gọi khác cho từng camera.
          selector:
            entity:
              filter:
                - domain:
                    - sensor
                  integration: template
              multiple: false
              reorder: false
          default:

    ai_task_settings:
      name: AI Task Settings
      icon: mdi:robot-outline
      collapsed: true
      input:
        ai_task_entity:
          name: AI Task Entity
          description: >
            Chọn AI Task entity nếu muốn chỉ định AI Task cụ thể.
            Để trống nếu muốn dùng ai_task.generate_data mặc định.
          selector:
            entity:
              filter:
                - domain:
                    - ai_task
              multiple: false
              reorder: false
          default:

        delay_between_cameras:
          name: Delay Between Cameras (seconds)
          description: Chỉ dùng khi phân tích nhiều camera.
          selector:
            number:
              min: 0.0
              max: 10.0
              step: 0.5
              unit_of_measurement: s
              mode: slider
          default: 1

  source_url: https://github.com/thaibacgiang/thaibot/edit/main/Voice_Smart_Camera_AI_Analyzer.yaml

mode: parallel
max_exceeded: silent

fields:
  instructions:
    name: Camera Question
    description: >
      Hỏi về camera.
      Ví dụ:
      "camera sân vườn có người không"
      "cam phòng trà thấy gì"
      "phòng khách có ai không"
      "camera nào đang có người"
    selector:
      text:
        multiline: true
    required: true

sequence:

  # ============================================================
  # 1. NHẬN INPUT
  # ============================================================

  - variables:
      entity_aliases: !input entity_aliases
      ai_task_entity: !input ai_task_entity
      delay_between_cameras: !input delay_between_cameras

      user_question: "{{ instructions | default('') | trim }}"

  # ============================================================
  # 2. KIỂM TRA CÂU HỎI
  # ============================================================

  - if:
      - condition: template
        value_template: "{{ not user_question }}"

    then:
      - variables:
          response:
            mode: error
            error: "Vui lòng nhập câu hỏi về camera."
            timestamp: "{{ now().isoformat() }}"

      - stop: Missing question
        response_variable: response

  # ============================================================
  # 3. LẤY DANH SÁCH CAMERA
  # ============================================================

  - variables:
      all_cameras: >
        {% set ns = namespace(cams=[]) %}

        {% for cam in states.camera %}
          {% if cam.entity_id not in ns.cams %}
            {% set ns.cams = ns.cams + [cam.entity_id] %}
          {% endif %}
        {% endfor %}

        {{ ns.cams }}

      user_question_lc: "{{ user_question | lower | trim }}"

  # ============================================================
  # 4. XÁC ĐỊNH CÓ YÊU CẦU TẤT CẢ CAMERA KHÔNG
  #
  # Chỉ những câu rõ ràng như:
  # "tất cả camera"
  # "camera nào có người"
  # "các camera"
  # mới quét toàn bộ.
  #
  # "camera sân vườn" KHÔNG phải multi.
  # ============================================================

  - variables:
      explicit_multi_request: >
        {% set q = user_question_lc %}

        {{
          'tất cả camera' in q
          or 'tất cả các camera' in q
          or 'tất cả cam' in q
          or 'các camera' in q
          or 'các cam' in q
          or 'những camera' in q
          or 'những cam' in q
          or 'camera nào' in q
          or 'cam nào' in q
          or 'toàn bộ camera' in q
          or 'toàn bộ các camera' in q
          or 'toàn bộ' in q
          or 'all camera' in q
          or 'all cameras' in q
          or 'check all' in q
        }}

  # ============================================================
  # 5. TÌM CAMERA THEO FRIENDLY NAME
  #
  # Ví dụ:
  # Camera Sân Vườn
  # → "camera sân vườn"
  # → "cam sân vườn"
  # → "sân vườn"
  #
  # Camera Phòng Trà
  # → "camera phòng trà"
  # → "cam phòng trà"
  # → "phòng trà"
  # ============================================================

  - variables:
      matched_cameras_by_name: >
        {% set q = user_question_lc %}
        {% set ns = namespace(found=[]) %}

        {% for cam in all_cameras %}

          {% set fn = state_attr(cam, 'friendly_name')
            | default('')
            | lower
            | trim %}

          {% if fn %}

            {% set name_without_camera =
              fn
              | replace('camera ', '')
              | replace('cam ', '')
              | trim
            %}

            {% set name_without_words =
              fn
              | replace('camera', '')
              | replace('cam', '')
              | trim
            %}

            {% if
              fn in q
              or name_without_camera in q
              or name_without_words in q
            %}

              {% if cam not in ns.found %}
                {% set ns.found = ns.found + [cam] %}
              {% endif %}

            {% endif %}

          {% endif %}

        {% endfor %}

        {{ ns.found }}

  # ============================================================
  # 6. TÌM CAMERA THEO ALIAS
  # ============================================================

  - variables:
      matched_cameras_by_alias: >
        {% set q = user_question_lc %}
        {% set ns = namespace(found=[]) %}

        {% if entity_aliases %}

          {% set entities =
            state_attr(entity_aliases, 'entities')
            | default([])
          %}

          {% for item in entities %}

            {% set eid = item.entity_id | default('') %}
            {% set aliases = item.aliases | default([]) %}

            {% if eid.startswith('camera.') %}

              {% for alias in aliases %}

                {% set a =
                  alias
                  | default('')
                  | lower
                  | trim
                %}

                {% if a and a in q %}

                  {% if eid not in ns.found %}
                    {% set ns.found = ns.found + [eid] %}
                  {% endif %}

                {% endif %}

              {% endfor %}

            {% endif %}

          {% endfor %}

        {% endif %}

        {{ ns.found }}

  # ============================================================
  # 7. TÌM CAMERA THEO TỪ KHÓA
  #
  # Bao gồm:
  # - phòng khách
  # - nhà xe
  # - cửa trước
  # - phòng master
  # - phòng bếp
  # - sân vườn
  # - phòng trà
  # ============================================================

  - variables:
      guessed_cameras: >
        {% set q = user_question_lc %}
        {% set ns = namespace(found=[]) %}

        {% for cam in all_cameras %}

          {% set fn =
            state_attr(cam, 'friendly_name')
            | default('')
            | lower
            | trim
          %}

          {% set matched = false %}

          {# PHÒNG KHÁCH #}
          {% if 'phòng khách' in q and 'phòng khách' in fn %}
            {% set matched = true %}
          {% endif %}

          {# NHÀ XE #}
          {% if
            ('nhà xe' in q or 'nha xe' in q)
            and
            ('nhà xe' in fn or 'nha xe' in fn)
          %}
            {% set matched = true %}
          {% endif %}

          {# CỬA TRƯỚC #}
          {% if 'cửa trước' in q and 'cửa trước' in fn %}
            {% set matched = true %}
          {% endif %}

          {# PHÒNG MASTER #}
          {% if 'phòng master' in q and 'phòng master' in fn %}
            {% set matched = true %}
          {% endif %}

          {# PHÒNG BẾP #}
          {% if 'phòng bếp' in q and 'phòng bếp' in fn %}
            {% set matched = true %}
          {% endif %}

          {# SÂN VƯỜN #}
          {% if
            ('sân vườn' in q or 'san vuon' in q)
            and
            ('sân vườn' in fn or 'san vuon' in fn)
          %}
            {% set matched = true %}
          {% endif %}

          {# PHÒNG TRÀ #}
          {% if
            ('phòng trà' in q or 'phong tra' in q)
            and
            ('phòng trà' in fn or 'phong tra' in fn)
          %}
            {% set matched = true %}
          {% endif %}

          {% if matched and cam not in ns.found %}
            {% set ns.found = ns.found + [cam] %}
          {% endif %}

        {% endfor %}

        {{ ns.found }}

  # ============================================================
  # 8. GỘP DANH SÁCH CAMERA ĐƯỢC NHẬN DIỆN
  # ============================================================

  - variables:
      target_cameras: >
        {% set ns = namespace(found=[]) %}

        {% for cam in matched_cameras_by_name %}
          {% if cam not in ns.found %}
            {% set ns.found = ns.found + [cam] %}
          {% endif %}
        {% endfor %}

        {% for cam in matched_cameras_by_alias %}
          {% if cam not in ns.found %}
            {% set ns.found = ns.found + [cam] %}
          {% endif %}
        {% endfor %}

        {% for cam in guessed_cameras %}
          {% if cam not in ns.found %}
            {% set ns.found = ns.found + [cam] %}
          {% endif %}
        {% endfor %}

        {{ ns.found }}

  # ============================================================
  # 9. XÁC ĐỊNH MODE
  #
  # explicit_multi_request = true
  #     → ALL CAMERA
  #
  # target_cameras > 1
  #     → MULTI
  #
  # target_cameras = 1
  #     → SINGLE
  #
  # target_cameras = 0
  #     → ERROR
  #
  # QUAN TRỌNG:
  # Không còn fallback:
  # "không tìm thấy camera → tất cả camera"
  # ============================================================

  - variables:
      use_mode: >
        {% if explicit_multi_request %}
          multi
        {% elif target_cameras | length > 1 %}
          multi
        {% elif target_cameras | length == 1 %}
          single
        {% else %}
          error
        {% endif %}

  # ============================================================
  # 10. CAMERA KHÔNG XÁC ĐỊNH ĐƯỢC
  # ============================================================

  - choose:

      - conditions:
          - condition: template
            value_template: "{{ use_mode == 'error' }}"

        sequence:

          - variables:
              response:
                mode: error
                error: >
                  Tôi chưa xác định được camera anh muốn hỏi.
                  Anh hãy nói rõ tên camera, ví dụ:
                  camera sân vườn, camera phòng trà hoặc camera phòng khách.

                question: "{{ user_question }}"

                timestamp: "{{ now().isoformat() }}"

          - stop: Camera not identified
            response_variable: response

  # ============================================================
  # 11. SINGLE CAMERA
  #
  # CHỈ GỬI 1 CAMERA CHO AI.
  # ============================================================

      - conditions:
          - condition: template
            value_template: "{{ use_mode == 'single' }}"

        sequence:

          - variables:
              final_camera: "{{ target_cameras[0] }}"

              camera_name: >
                {{ state_attr(
                    final_camera,
                    'friendly_name'
                  ) or final_camera }}

              single_prompt: |
                Bạn đang phân tích DUY NHẤT một camera.

                CAMERA:
                {{ camera_name }}

                CÂU HỎI:
                "{{ user_question }}"

                QUY TẮC:

                - Chỉ phân tích hình ảnh của camera {{ camera_name }}.
                - Không phân tích bất kỳ camera nào khác.
                - Không suy đoán hình ảnh từ camera khác.
                - Trả lời bằng tiếng Việt có dấu.
                - Trả lời trực tiếp, tự nhiên.
                - Tối đa 2-3 câu.
                - Nếu hỏi có người:
                  trả lời "Có người" hoặc "Không có người".
                - Nếu nhìn rõ nhiều người:
                  có thể nói số lượng ước tính.
                - Nếu hỏi về xe:
                  mô tả xe nếu nhìn rõ.
                - Nếu hỏi về thú cưng:
                  mô tả thú cưng nếu nhìn rõ.
                - Nếu hỏi "thấy gì":
                  mô tả các đối tượng chính đang nhìn thấy.
                - Nếu camera tối, mờ hoặc bị che:
                  nói "Camera bị tối/che khuất nên tôi không nhìn rõ."
                - Không nói về camera khác.
                - Không liệt kê các camera khác.
                - Không thêm tiêu đề.
                - Không thêm định dạng Markdown.

              camera_attachment:
                media_content_id: >
                  media-source://camera/{{ final_camera }}
                media_content_type: image/jpeg
                metadata:
                  title: "{{ camera_name }}"
                  media_class: image

          # ------------------------------------------------------
          # GỌI AI
          # ------------------------------------------------------

          - choose:

              - conditions:
                  - condition: template
                    value_template: "{{ not ai_task_entity }}"

                sequence:

                  - action: ai_task.generate_data
                    data:
                      task_name: "Analyze {{ camera_name }}"
                      instructions: "{{ single_prompt }}"
                      attachments:
                        - "{{ camera_attachment }}"

                    response_variable: ai_result

            default:

              - action: ai_task.generate_data
                data:
                  entity_id: "{{ ai_task_entity }}"
                  task_name: "Analyze {{ camera_name }}"
                  instructions: "{{ single_prompt }}"
                  attachments:
                    - "{{ camera_attachment }}"

                response_variable: ai_result

          # ------------------------------------------------------
          # TRẢ KẾT QUẢ NGAY
          # ------------------------------------------------------

          - variables:
              response:
                mode: single
                camera: "{{ final_camera }}"
                camera_name: "{{ camera_name }}"

                answer: >
                  {{ ai_result.data
                     if ai_result.data is defined
                     else 'Lỗi phân tích camera.' }}

                timestamp: "{{ now().isoformat() }}"

          - stop: Single camera completed
            response_variable: response

  # ============================================================
  # 12. MULTI CAMERA
  #
  # Trường hợp:
  # "tất cả camera"
  # "camera nào có người"
  # "các camera"
  #
  # → phân tích toàn bộ.
  #
  # Nếu nhận diện được nhiều camera cụ thể:
  # "sân vườn và phòng trà"
  #
  # → chỉ phân tích 2 camera đó.
  # ============================================================

      - conditions:
          - condition: template
            value_template: "{{ use_mode == 'multi' }}"

        sequence:

          - variables:
              cameras_to_analyze: >
                {% if explicit_multi_request %}
                  {{ all_cameras }}
                {% else %}
                  {{ target_cameras }}
                {% endif %}

          # ------------------------------------------------------
          # KIỂM TRA DANH SÁCH
          # ------------------------------------------------------

          - if:
              - condition: template
                value_template: >
                  {{ cameras_to_analyze | length == 0 }}

            then:

              - variables:
                  response:
                    mode: error
                    error: "Không tìm thấy camera để phân tích."
                    timestamp: "{{ now().isoformat() }}"

              - stop: No cameras
                response_variable: response

          # ------------------------------------------------------
          # DANH SÁCH KẾT QUẢ
          # ------------------------------------------------------

          - variables:
              camera_results: []

          # ------------------------------------------------------
          # PHÂN TÍCH TỪNG CAMERA
          # ------------------------------------------------------

          - repeat:
              for_each: "{{ cameras_to_analyze }}"

              sequence:

                - variables:
                    current_camera: "{{ repeat.item }}"

                    camera_name: >
                      {{ state_attr(
                          repeat.item,
                          'friendly_name'
                        ) or repeat.item }}

                    camera_attachment:
                      media_content_id: >
                        media-source://camera/{{ repeat.item }}
                      media_content_type: image/jpeg
                      metadata:
                        title: >
                          {{ state_attr(
                              repeat.item,
                              'friendly_name'
                            ) or repeat.item }}
                        media_class: image

                # ------------------------------------------------
                # PROMPT
                # ------------------------------------------------

                - variables:
                    current_prompt: |
                      Bạn đang phân tích DUY NHẤT camera:

                      {{ camera_name }}

                      CÂU HỎI CỦA NGƯỜI DÙNG:
                      "{{ user_question }}"

                      QUY TẮC:

                      - Chỉ phân tích hình ảnh camera hiện tại.
                      - Không suy đoán camera khác.
                      - Không sử dụng thông tin từ camera khác.
                      - Trả lời bằng tiếng Việt có dấu.
                      - Nếu hỏi có người:
                        "Có người" hoặc "Không có người".
                      - Nếu thấy nhiều người:
                        ước lượng số lượng nếu nhìn rõ.
                      - Nếu hỏi mô tả:
                        mô tả những gì thực sự nhìn thấy.
                      - Nếu camera tối hoặc bị che:
                        "Camera bị tối/che khuất."
                      - Chỉ trả lời 1-2 câu.

                # ------------------------------------------------
                # AI
                # ------------------------------------------------

                - choose:

                    - conditions:
                        - condition: template
                          value_template: "{{ not ai_task_entity }}"

                      sequence:

                        - action: ai_task.generate_data
                          data:
                            task_name: "Analyze {{ camera_name }}"
                            instructions: "{{ current_prompt }}"
                            attachments:
                              - "{{ camera_attachment }}"

                          response_variable: ai_single_result

                  default:

                    - action: ai_task.generate_data
                      data:
                        entity_id: "{{ ai_task_entity }}"
                        task_name: "Analyze {{ camera_name }}"
                        instructions: "{{ current_prompt }}"
                        attachments:
                          - "{{ camera_attachment }}"

                      response_variable: ai_single_result

                # ------------------------------------------------
                # LƯU KẾT QUẢ
                # ------------------------------------------------

                - variables:
                    camera_results: >
                      {% set results = camera_results %}

                      {% set new_result = {
                        'camera': current_camera,
                        'camera_name': camera_name,
                        'analysis':
                          ai_single_result.data
                          if ai_single_result.data is defined
                          else 'Lỗi phân tích',
                        'timestamp': now().isoformat()
                      } %}

                      {{ results + [new_result] }}

                # ------------------------------------------------
                # DELAY
                # ------------------------------------------------

                - if:
                    - condition: template
                      value_template: >
                        {{ repeat.index < cameras_to_analyze | length }}

                  then:

                    - delay:
                        seconds: "{{ delay_between_cameras }}"

          # ======================================================
          # 13. TỔNG HỢP
          # ======================================================

          - variables:
              summary_prompt: |
                Bạn là trợ lý giọng nói Home Assistant.

                CÂU HỎI CỦA NGƯỜI DÙNG:
                "{{ user_question }}"

                KẾT QUẢ PHÂN TÍCH:

                {% for result in camera_results %}
                - {{ result.camera_name }}:
                  {{ result.analysis }}
                {% endfor %}

                Hãy trả lời bằng tiếng Việt tự nhiên.

                QUY TẮC:

                - Chỉ sử dụng thông tin trong kết quả trên.
                - Không tự suy đoán thêm.
                - Nếu hỏi camera nào có người:
                  chỉ liệt kê camera có người.
                - Nếu không camera nào có người:
                  nói rõ không thấy người.
                - Nếu hỏi mô tả:
                  tóm tắt những gì nhìn thấy.
                - Không đọc lại toàn bộ dữ liệu.
                - Tối đa 3-4 câu.
                - Câu trả lời phù hợp để đọc bằng giọng nói.

          # ------------------------------------------------------
          # AI SUMMARY
          # ------------------------------------------------------

          - choose:

              - conditions:
                  - condition: template
                    value_template: "{{ not ai_task_entity }}"

                sequence:

                  - action: ai_task.generate_data
                    data:
                      task_name: "Summary"
                      instructions: "{{ summary_prompt }}"

                    response_variable: ai_summary_result

            default:

              - action: ai_task.generate_data
                data:
                  entity_id: "{{ ai_task_entity }}"
                  task_name: "Summary"
                  instructions: "{{ summary_prompt }}"

                response_variable: ai_summary_result

          # ======================================================
          # 14. TRẢ KẾT QUẢ
          # ======================================================

          - variables:
              response:
                mode: multi

                camera_count: >
                  {{ cameras_to_analyze | length }}

                cameras: >
                  {{ cameras_to_analyze }}

                individual_results: >
                  {{ camera_results }}

                summary: >
                  {{ ai_summary_result.data
                     if ai_summary_result.data is defined
                     else 'Không tổng hợp được kết quả.' }}

                timestamp: "{{ now().isoformat() }}"

          - stop: Multi camera completed
            response_variable: response
