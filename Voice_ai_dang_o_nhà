blueprint:
  name: Voice - Ai đang ở nhà
  description: >
    Hỏi bằng Voice hoặc Text trong Home Assistant Assist về những người
    được IRIS nhận diện trong 15 phút gần nhất. Trả về tên, vị trí camera,
    thời gian nhận diện và số phút đã trôi qua.
  domain: automation

  input:
    iris_sensor:
      name: IRIS People At Home
      description: Sensor chứa danh sách người IRIS nhận diện.
      selector:
        entity:
          domain: sensor

    time_window:
      name: Thời gian nhận diện
      description: Chỉ trả lời những người được IRIS nhận diện trong khoảng thời gian này.
      default: 15
      selector:
        number:
          min: 1
          max: 120
          step: 1
          unit_of_measurement: phút
          mode: box

trigger:
  - trigger: conversation
    command:
      - "Ai đang ở nhà"
      - "Ai ở nhà"
      - "Có ai ở nhà không"
      - "Nhà có ai"
      - "Nhà có những ai"
      - "Những ai đang ở nhà"
      - "Trong nhà có ai"
      - "Trong nhà đang có ai"
      - "Có những ai ở nhà"
      - "Hiện tại ai đang ở nhà"
      - "Hiện tại nhà có ai"
      - "Ai đang có mặt ở nhà"
      - "Những người nào đang ở nhà"
      - "Có người nào ở nhà không"
      - "Cho tôi biết ai đang ở nhà"
      - "Kiểm tra xem ai đang ở nhà"
      - "Kiểm tra trong nhà có ai"
      - "Xem ai đang ở nhà"

condition: []

action:
  - variables:
      people: >-
        {{ state_attr(iris_sensor, 'people') | default([], true) }}

  - set_conversation_response: >-
      {% set ns = namespace(people=[]) %}

      {% for p in people %}
        {% set name = p.name | default('') | string | trim %}
        {% set camera = p.camera | default('') | string | trim %}
        {% set last_seen = p.last_seen | default('') | string | trim %}

        {% if name not in ['', 'unknown', 'Unknown', 'No face detected', 'no face detected', 'None'] %}
          {% if camera != '' and last_seen != '' %}
            {% set ns.people = ns.people + [p] %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if ns.people | length == 0 %}

        Hiện tại không ghi nhận người quen nào được nhận diện trong {{ time_window }} phút qua.

      {% elif ns.people | length == 1 %}

        {% set p = ns.people[0] %}

        {% if p.last_seen is defined %}
          {% set time_text = p.last_seen %}
        {% else %}
          {% set time_text = 'không rõ thời gian' %}
        {% endif %}

        Hiện tại có {{ p.name }} ở {{ p.camera }}, được nhận diện lúc {{ time_text }}.

      {% else %}

        {% set text = namespace(value='Hiện tại có ' ~ (ns.people | length) ~ ' người được nhận diện: ') %}

        {% for p in ns.people %}

          {% if not loop.first %}
            {% set text.value = text.value ~ ' và ' %}
          {% endif %}

          {% set time_text = p.last_seen | default('không rõ thời gian') %}

          {% set text.value = text.value ~ p.name ~ ' ở ' ~ p.camera ~ ', được nhận diện lúc ' ~ time_text %}

        {% endfor %}

        {{ text.value }}.

      {% endif %}

mode: single
