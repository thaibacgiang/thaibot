blueprint:
  name: Voice - AI Đang Ở Nhà
  author: Thaidv1
  description: >
    🏠 TOOL CHỈ DÙNG CHO CÂU HỎI VỀ NGƯỜI ĐANG Ở NHÀ.

    Dữ liệu lấy từ sensor IRIS People At Home.

    SỬ DỤNG TOOL NÀY khi người dùng hỏi:
    - ai đang ở nhà
    - ai ở nhà
    - nhà có ai
    - trong nhà có ai
    - những ai đang ở nhà
    - hiện tại ai đang ở nhà
    - ai đang có mặt
    - người nào đang ở nhà
    - ai đang có mặt trong nhà
    - ai được nhận diện trong nhà

    KHÔNG dùng tool này để phân tích hình ảnh camera.

    Nếu người dùng hỏi camera thấy gì, camera có người không,
    camera sân vườn, camera phòng trà, camera phòng khách...
    thì phải sử dụng Smart Camera Analyzer.

  domain: script

  homeassistant:
    min_version: 2025.8.0

  input:
    settings:
      name: IRIS Settings
      icon: mdi:face-recognition
      input:

        iris_sensor:
          name: IRIS People At Home
          description: >
            Sensor chứa danh sách người được IRIS nhận diện.
          default: sensor.iris_people_at_home
          selector:
            entity:
              filter:
                - domain: sensor

        time_window:
          name: Thời gian hợp lệ
          description: >
            Chỉ coi người là đang ở nhà nếu lần nhận diện gần nhất
            nằm trong khoảng thời gian này.
          default: 15
          selector:
            number:
              min: 1
              max: 120
              step: 1
              mode: box
              unit_of_measurement: phút

fields:
  instructions:
    name: User Question
    description: >
      Câu hỏi tự nhiên của người dùng về những người đang ở nhà.
      Ví dụ: ai đang ở nhà, nhà có ai, hiện tại ai đang có mặt.
      KHÔNG dùng cho câu hỏi phân tích camera.
    required: true
    selector:
      text:
        multiline: true

mode: parallel
max: 10
max_exceeded: silent

sequence:

  - alias: "🏠 Lấy dữ liệu IRIS"
    variables:
      iris_entity: !input iris_sensor
      window_minutes: !input time_window
      user_question: "{{ instructions | default('') | trim }}"
      people: >
        {{ state_attr(iris_entity, 'people') | default([], true) }}

  - alias: "🔎 Lọc người còn hiệu lực"
    variables:
      valid_people: >
        {% set ns = namespace(result=[]) %}

        {% for p in people %}

          {% set name = p.name | default('') | string | trim %}
          {% set camera = p.camera | default('') | string | trim %}
          {% set last_seen = p.last_seen | default('') | string | trim %}
          {% set timestamp = p.last_seen_timestamp | default('') | string | trim %}

          {% if
            name
            and name | lower not in [
              'unknown',
              'none',
              'unknown person',
              'no face detected'
            ]
            and camera
            and timestamp
          %}

            {% set age =
              (as_timestamp(now()) - as_timestamp(timestamp)) / 60
            %}

            {% if age >= 0 and age <= window_minutes %}

              {% set ns.result = ns.result + [{
                'name': name,
                'camera': camera,
                'last_seen': last_seen,
                'last_seen_timestamp': timestamp,
                'age_minutes': age | int
              }] %}

            {% endif %}

          {% endif %}

        {% endfor %}

        {{ ns.result }}

  - alias: "💬 Tạo câu trả lời"
    variables:
      answer: >
        {% if valid_people | length == 0 %}

          Hiện tại tôi chưa nhận diện được ai đang ở nhà.

        {% else %}

          Hiện tại có {{ valid_people | length }} người đang ở nhà.

          {% for p in valid_people %}

            {{ p.name }}
            đang ở khu vực {{ p.camera }},
            nhận diện lúc {{ p.last_seen }},
            cách đây {{ p.age_minutes }} phút.

          {% endfor %}

        {% endif %}

  - alias: "📤 Trả kết quả cho Gemini"
    variables:
      response:
        tool: iris_people_at_home
        success: true
        answer: "{{ answer | trim }}"
        count: "{{ valid_people | length }}"
        people: "{{ valid_people }}"
        timestamp: "{{ now().isoformat() }}"

  - stop: "IRIS People At Home completed"
    response_variable: response
