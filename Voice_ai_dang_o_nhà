blueprint:
  name: Voice - AI Đang Ở Nhà
  author: Thaidv1
  description: >
    Hỏi bằng Voice hoặc Text trong Home Assistant Assist để biết
    những người IRIS đã nhận diện gần đây.

  domain: automation
  homeassistant:
    min_version: 2026.1.0

  input: {}

trigger:
  - trigger: conversation
    command:
      - "ai đang ở nhà"
      - "ai ở nhà"
      - "có ai ở nhà không"
      - "nhà có ai"
      - "nhà đang có ai"
      - "những ai đang ở nhà"
      - "trong nhà có ai"
      - "trong nhà đang có ai"
      - "hiện tại ai đang ở nhà"
      - "hiện tại nhà có ai"
      - "ai đang có mặt ở nhà"

action:
  - variables:
      people: >
        {{ state_attr('sensor.iris_people_at_home', 'people')
           | default([], true) }}

  - set_conversation_response: >
      {% if people | length == 0 %}
        Hiện tại tôi chưa ghi nhận người nào trong nhà.
      {% elif people | length == 1 %}
        {% set p = people[0] %}
        Hiện tại có {{ p.name }} ở {{ p.camera }},
        được nhận diện lúc {{ p.last_seen }}.
      {% else %}
        {% set ns = namespace(text='Hiện tại có ' ~ (people | length) ~ ' người: ') %}

        {% for p in people %}
          {% if not loop.first %}
            {% set ns.text = ns.text ~ ', ' %}
          {% endif %}

          {% set ns.text = ns.text ~ p.name ~
            ' ở ' ~ p.camera ~
            ', nhận diện lúc ' ~ p.last_seen %}
        {% endfor %}

        {{ ns.text }}.
      {% endif %}

mode: single
