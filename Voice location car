blueprint:
  name: Voice - Send Location to Telegram
  author: Thaidv1
  description: >
    📍 Gửi vị trí từ device_tracker lên Telegram —
    phiên bản tương thích HA 2026.1.0.
    - Dùng target (schema mới).
    - Không dùng chat_id.
    - An toàn template, không lỗi YAML.

  domain: script
  homeassistant:
    min_version: 2026.1.0

  input:
    telegram_settings:
      name: Cài đặt Telegram
      icon: mdi:telegram
      input:
        target:
          name: Target (Chat / Group ID)
          description: >
            ID nhóm hoặc người nhận vị trí.
            Ví dụ: -1002936213456
          selector:
            text:
              multiline: false

    location_settings:
      name: Cài đặt vị trí
      icon: mdi:map-marker
      input:
        tracker_entity:
          name: Device Tracker
          description: >
            Chọn device_tracker cần gửi vị trí.
            Ví dụ: device_tracker.vinfast_vf6_location
          selector:
            entity:
              domain: device_tracker
              multiple: false

        message:
          name: Nội dung kèm theo
          description: >
            Tin nhắn gửi kèm vị trí (tuỳ chọn).
          selector:
            text:
              multiline: true
          default: "🚗 Vị trí hiện tại"

mode: queued
max: 30
max_exceeded: silent

fields: {}

sequence:
  - alias: "📍 Lấy toạ độ từ device_tracker"
    variables:
      lat: "{{ state_attr(tracker_entity, 'latitude') }}"
      lon: "{{ state_attr(tracker_entity, 'longitude') }}"

  - alias: "📤 Gửi vị trí đến Telegram"
    action: telegram_bot.send_location
    data:
      target: !input target
      latitude: "{{ lat }}"
      longitude: "{{ lon }}"
    response_variable: telegram_result

  - choose:
      - conditions:
          - condition: template
            value_template: >
              {{ telegram_result is defined and telegram_result is not none }}
        sequence:
          - action: telegram_bot.send_message
            data:
              target: !input target
              message: >
                {{ message }}
                https://maps.google.com/?q={{ lat }},{{ lon }}

  - stop: "done"
