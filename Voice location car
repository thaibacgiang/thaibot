blueprint:
  name: Voice - Send Location to Telegram
  author: Thaidv1
  description: >
    📍 Gửi vị trí từ device_tracker lên Telegram
    (kèm tin nhắn + link Google Maps).
    Tương thích HA 2026.1.0+

  domain: script
  homeassistant:
    min_version: 2026.1.0

  input:
    telegram_settings:
      name: Cài đặt Telegram
      icon: mdi:telegram
      input:
        chat_id:
          name: chat_id (Chat / Group ID)
          description: >
            ID nhóm hoặc người nhận.
            Ví dụ: -1002936213456
          selector:
            text:

    location_settings:
      name: Cài đặt vị trí
      icon: mdi:map-marker
      input:
        tracker_entity:
          name: Device Tracker
          selector:
            entity:
              domain: device_tracker

        message:
          name: Nội dung kèm theo
          default: "🚗 Vị trí hiện tại của xe"
          selector:
            text:
              multiline: true

mode: queued
max: 30
max_exceeded: silent

sequence:
  - alias: "📍 Lấy dữ liệu"
    variables:
      tracker: !input tracker_entity
      message: !input message
      lat: "{{ state_attr(tracker, 'latitude') }}"
      lon: "{{ state_attr(tracker, 'longitude') }}"

  - alias: "📤 Gửi vị trí"
    action: telegram_bot.send_location
    data:
      chat_id: !input chat_id
      latitude: "{{ lat }}"
      longitude: "{{ lon }}"

  - alias: "💬 Gửi tin nhắn kèm link"
    action: telegram_bot.send_message
    data:
      chat_id: !input chat_id
      message: >
        {{ message }}
        📍 https://maps.google.com/?q={{ lat }},{{ lon }}
