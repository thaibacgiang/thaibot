blueprint:
  name: Voice - AI Đang Ở Nhà và cam chuyển động
  author: Thaidv1
  description: >
    🏠 TOOL CHỈ DÙNG CHO CÂU HỎI "AI ĐANG Ở NHÀ".

    Kết hợp IRIS Face Recognition và sensor chuyển động camera.

    IRIS nhận diện được người:
    → Trả tên + camera + thời gian.

    Unknown Visitor:
    → Có người nhưng chưa xác định được danh tính.

    Camera đang có motion nhưng IRIS không có người hợp lệ:
    → Có thể có người chưa được nhận diện.

    Tất cả dữ liệu IRIS quá 15 phút sẽ được bỏ qua.

    Không phân tích hình ảnh camera.

  domain: script

  homeassistant:
    min_version: 2025.8.0

  input:

    iris_settings:
      name: IRIS
      icon: mdi:face-recognition
      input:

        iris_sensor:
          name: IRIS People At Home
          description: >
            Sensor chứa danh sách người IRIS nhận diện.
          default: sensor.iris_people_at_home
          selector:
            entity:
              filter:
                - domain: sensor

    camera_settings:
      name: Camera Motion
      icon: mdi:cctv
      input:

        motion_cameras:
          name: Sensor cử động camera
          description: >
            Các binary_sensor phát hiện chuyển động của camera.
          selector:
            entity:
              multiple: true
              filter:
                - domain: binary_sensor

fields:

  instructions:
    name: User Question
    description: >
      Câu hỏi về người đang ở nhà.
      Ví dụ: ai đang ở nhà, nhà có ai,
      những ai đang có mặt.
    required: true
    selector:
      text:
        multiline: true

mode: parallel
max: 10
max_exceeded: silent

sequence:

  # =========================================================
  # 1. LẤY DỮ LIỆU
  # =========================================================

  - alias: "🏠 Lấy dữ liệu IRIS"
    variables:
      iris_entity: !input iris_sensor
      motion_entities: !input motion_cameras

      people: >
        {{ state_attr(iris_entity, 'people') | default([], true) }}

      now_minutes: >
        {{ now().hour * 60 + now().minute }}


  # =========================================================
  # 2. NGƯỜI ĐÃ NHẬN DIỆN - CHỈ GIỮ TRONG 15 PHÚT
  # =========================================================

  - alias: "👤 Lọc người đã nhận diện trong 15 phút"
    variables:

      recognized: >
        {% set ns = namespace(result=[]) %}

        {% for p in people %}

          {% set name =
            p.name | default('') | string | trim
          %}

          {% set camera =
            p.camera | default('') | string | trim
          %}

          {% set last_seen =
            p.last_seen | default('') | string | trim
          %}

          {% if
            name
            and camera
            and last_seen
            and name | lower not in [
              'unknown visitor',
              'no face detected',
              'unknown',
              'unknown person'
            ]
          %}

            {% set parts = last_seen
              | replace('h', ':')
              | split(':')
            %}

            {% if parts | length >= 2 %}

              {% set seen_hour = parts[0] | int(0) %}
              {% set seen_minute = parts[1] | int(0) %}

              {% set seen_total =
                seen_hour * 60 + seen_minute
              %}

              {% set age =
                now_minutes - seen_total
              %}

              {# Xử lý trường hợp qua 00:00 #}
              {% if age < 0 %}
                {% set age = age + 1440 %}
              {% endif %}

              {% if age <= 15 %}

                {% set item = {
                  'name': name,
                  'camera': camera,
                  'last_seen': last_seen,
                  'age_minutes': age
                } %}

                {% if item not in ns.result %}
                  {% set ns.result =
                    ns.result + [item]
                  %}
                {% endif %}

              {% endif %}

            {% endif %}

          {% endif %}

        {% endfor %}

        {{ ns.result }}


  # =========================================================
  # 3. UNKNOWN VISITOR - CHỈ GIỮ TRONG 15 PHÚT
  # =========================================================

  - alias: "❓ Lọc Unknown Visitor trong 15 phút"
    variables:

      unknown_iris: >
        {% set ns = namespace(result=[]) %}

        {% for p in people %}

          {% set name =
            p.name | default('') | string | trim | lower
          %}

          {% set camera =
            p.camera | default('') | string | trim
          %}

          {% set last_seen =
            p.last_seen | default('') | string | trim
          %}

          {% if
            name == 'unknown visitor'
            and camera
            and last_seen
          %}

            {% set parts = last_seen
              | replace('h', ':')
              | split(':')
            %}

            {% if parts | length >= 2 %}

              {% set seen_hour = parts[0] | int(0) %}
              {% set seen_minute = parts[1] | int(0) %}

              {% set seen_total =
                seen_hour * 60 + seen_minute
              %}

              {% set age =
                now_minutes - seen_total
              %}

              {# Xử lý qua 00:00 #}
              {% if age < 0 %}
                {% set age = age + 1440 %}
              {% endif %}

              {% if age <= 15 %}

                {% set item = {
                  'camera': camera,
                  'last_seen': last_seen,
                  'age_minutes': age
                } %}

                {% if item not in ns.result %}
                  {% set ns.result =
                    ns.result + [item]
                  %}
                {% endif %}

              {% endif %}

            {% endif %}

          {% endif %}

        {% endfor %}

        {{ ns.result }}


  # =========================================================
  # 4. CAMERA ĐANG MOTION
  # =========================================================

  - alias: "📹 Camera đang chuyển động"
    variables:

      active_motion: >
        {% set ns = namespace(result=[]) %}

        {% for entity in motion_entities %}

          {% if is_state(entity, 'on') %}

            {% set camera =
              state_attr(entity, 'friendly_name')
              | default(entity)
              | string
            %}

            {% set ns.result =
              ns.result + [camera]
            %}

          {% endif %}

        {% endfor %}

        {{ ns.result }}


  # =========================================================
  # 5. CAMERA MOTION NHƯNG CHƯA CÓ IRIS NHẬN DIỆN
  # =========================================================

  - alias: "❓ Tìm camera có người chưa xác định"
    variables:

      possible_unknown: >
        {% set ns = namespace(result=[]) %}

        {% for entity in motion_entities %}

          {% if is_state(entity, 'on') %}

            {% set motion_camera =
              state_attr(entity, 'friendly_name')
              | default(entity)
              | string
            %}

            {% set has_recognized =
              namespace(value=false)
            %}

            {% for p in recognized %}

              {% if
                p.camera | lower
                == motion_camera | lower
              %}

                {% set has_recognized.value = true %}

              {% endif %}

            {% endfor %}


            {% set has_unknown =
              namespace(value=false)
            %}

            {% for p in unknown_iris %}

              {% if
                p.camera | lower
                == motion_camera | lower
              %}

                {% set has_unknown.value = true %}

              {% endif %}

            {% endfor %}


            {% if
              not has_recognized.value
              and not has_unknown.value
            %}

              {% set ns.result =
                ns.result + [motion_camera]
              %}

            {% endif %}

          {% endif %}

        {% endfor %}

        {{ ns.result }}


  # =========================================================
  # 6. TẠO CÂU TRẢ LỜI
  # =========================================================

  - alias: "💬 Tạo câu trả lời"
    variables:

      answer: >

        {% if
          recognized | length == 0
          and unknown_iris | length == 0
          and possible_unknown | length == 0
        %}

          Hiện tại không phát hiện có người ở nhà.

        {% else %}


          {% if recognized | length > 0 %}

            Hiện có {{ recognized | length }}
            người đã được nhận diện.

            {% for p in recognized %}

              {{ p.name }}
              đang ở {{ p.camera }},
              nhận diện lúc {{ p.last_seen }}.

            {% endfor %}

          {% endif %}


          {% if unknown_iris | length > 0 %}

            {% for p in unknown_iris %}

              Camera {{ p.camera }}
              phát hiện người chưa xác định,
              lúc {{ p.last_seen }}.

            {% endfor %}

          {% endif %}


          {% if possible_unknown | length > 0 %}

            {% for camera in possible_unknown %}

              Camera {{ camera }}
              đang phát hiện chuyển động,
              có thể có người chưa được nhận diện.

            {% endfor %}

          {% endif %}


        {% endif %}


  # =========================================================
  # 7. TRẢ KẾT QUẢ CHO GEMINI
  # =========================================================

  - alias: "🤖 Trả kết quả cho Gemini"
    variables:

      response:
        tool: iris_people_at_home
        success: true
        answer: "{{ answer | trim }}"
        recognized_people: "{{ recognized }}"
        unknown_people: "{{ unknown_iris }}"
        motion_cameras: "{{ active_motion }}"
        possible_unknown: "{{ possible_unknown }}"

  - stop: "IRIS People At Home completed"
    response_variable: response
