blueprint:
  name: Voice - AI Đang Ở Nhà
  author: Thaidv1
  description: >
    🏠 Trả lời câu hỏi "ai đang ở nhà" bằng cách kết hợp
    IRIS nhận diện khuôn mặt và sensor chuyển động camera.

    Dùng tool này cho:
    - ai đang ở nhà
    - nhà có ai
    - những ai đang ở nhà
    - ai đang có mặt

    Không dùng tool này để phân tích hình ảnh camera.

  domain: script

  homeassistant:
    min_version: 2025.8.0

  input:
    iris_sensor:
      name: IRIS People At Home
      description: Sensor chứa danh sách người IRIS đã nhận diện.
      default: sensor.iris_people_at_home
      selector:
        entity:
          filter:
            - domain: sensor

    motion_cameras:
      name: Sensor cử động camera
      description: Các sensor phát hiện chuyển động của camera.
      selector:
        entity:
          multiple: true
          filter:
            - domain: binary_sensor

fields:
  instructions:
    name: User Question
    description: >
      Câu hỏi về người đang ở nhà.
      Ví dụ: ai đang ở nhà, nhà có ai, ai đang có mặt.
    required: true
    selector:
      text:
        multiline: true

sequence:

  - variables:
      iris_entity: !input iris_sensor
      motion_entities: !input motion_cameras
      people: >
        {{ state_attr(iris_entity, 'people') | default([], true) }}

  - variables:
      recognized: >
        {% set ns = namespace(result=[]) %}

        {% for p in people %}
          {% set name = p.name | default('') | string | trim %}
          {% set camera = p.camera | default('') | string | trim %}
          {% set last_seen = p.last_seen | default('') | string | trim %}
          {% set timestamp = p.last_seen_timestamp | default('') | string | trim %}

          {% if name and camera and timestamp %}
            {% set age = (as_timestamp(now()) - as_timestamp(timestamp)) / 60 %}

            {% if age >= 0 and age <= 15 %}
              {% set ns.result = ns.result + [{
                'name': name,
                'camera': camera,
                'last_seen': last_seen,
                'age': age | int
              }] %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {{ ns.result }}

  - variables:
      motion: >
        {% set ns = namespace(result=[]) %}

        {% for entity in motion_entities %}
          {% if is_state(entity, 'on') %}
            {% set name = state_attr(entity, 'friendly_name') | default(entity) %}
            {% set ns.result = ns.result + [name] %}
          {% endif %}
        {% endfor %}

        {{ ns.result }}

  - variables:
      answer: >
        {% if recognized | length == 0 and motion | length == 0 %}

          Hiện tại không phát hiện có người ở nhà.

        {% else %}

          {% if recognized | length > 0 %}

            Hiện có {{ recognized | length }} người đã được nhận diện.

            {% for p in recognized %}
              {{ p.name }} đang ở {{ p.camera }}, nhận diện lúc {{ p.last_seen }}.
            {% endfor %}

          {% endif %}

          {% if motion | length > 0 %}

            {% if recognized | length > 0 %}
              Ngoài ra,
            {% endif %}

            {% for cam in motion %}
              {{ cam }} đang phát hiện chuyển động, có thể có người chưa được nhận diện.
            {% endfor %}

          {% endif %}

        {% endif %}

  - variables:
      response:
        tool: iris_people_at_home
        success: true
        answer: "{{ answer | trim }}"
        recognized_people: "{{ recognized }}"
        motion_cameras: "{{ motion }}"

  - stop: "IRIS People At Home completed"
    response_variable: response

mode: parallel
max: 10
max_exceeded: silent
